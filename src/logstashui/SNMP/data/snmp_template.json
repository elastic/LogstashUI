              "ignore_above": 1024
            },
            "polled_address": {
              "type": "keyword",
              "ignore_above": 1024,
              "time_series_dimension": true,
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "device_template": {
              "type": "keyword",
              "ignore_above": 1024,
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "ip": {
              "type": "ip"
            },
            "location": {
              "properties": {
                "building": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "geo": {
                  "type": "geo_point"
                },
                "room": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "site": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            }
          }
        },
        "component": {
