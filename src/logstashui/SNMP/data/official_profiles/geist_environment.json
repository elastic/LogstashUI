    "observer.serial_number": "1.3.6.1.4.1.21239.5.1.1.10.0",
    "observer.mac_address": "1.3.6.1.4.1.21239.5.1.1.4.0",
    "env.sensor_label": "1.3.6.1.4.1.21239.5.1.2.1.3.1",
    "env.temperature_c": "1.3.6.1.4.1.21239.5.1.2.1.5.1",
