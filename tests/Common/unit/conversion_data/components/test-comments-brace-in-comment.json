{
    "input": [],
    "filter": [
        {
            "id": "filter_mutate_0",
            "type": "filter",
            "plugin": "mutate",
            "config": {
                "add_field": {
                    "real_field": "real_value"
                },
                "remove_field": [
                    "unwanted"
                ]
            },
            "comments": [
                "add_field => {\"this_key\" => \"this_value\"}",
                "rename => {\"old_field\" => \"new_field\"}",
                "remove_field => [\"field1\", \"field2\"]",
                "replace => {\"message\" => \"override: %{message}\"}"
            ]
        },
        {
            "id": "filter_grok_1",
            "type": "filter",
            "plugin": "grok",
            "config": {
                "match": {
                    "message": "%{GREEDYDATA:raw_message}"
                }
            },
            "comments": [
                "match => { \"message\" => \"%{COMBINEDAPACHELOG}\" }",
                "pattern_definitions => { \"MY_PATTERN\" => \"\\\\w+\" }"
            ]
        },
        {
            "id": "filter_date_2",
            "type": "filter",
            "plugin": "date",
            "config": {
                "match": [
                    "timestamp",
                    "ISO8601"
                ],
                "target": "@timestamp"
            },
            "comments": [
                "match => [\"timestamp\", \"dd/MMM/yyyy:HH:mm:ss Z\", \"ISO8601\"]",
                "target => \"@timestamp\""
            ]
        },
        {
            "id": "filter_translate_3",
            "type": "filter",
            "plugin": "translate",
            "config": {
                "field": "status_code",
                "destination": "status_label",
                "dictionary": {
                    "200": "OK",
                    "404": "Not Found"
                },
                "fallback": "Unknown"
            },
            "comments": [
                "dictionary => { \"200\" => \"OK\", \"404\" => \"Not Found\", \"500\" => \"Error\" }"
            ]
        }
    ],
    "output": []
}
